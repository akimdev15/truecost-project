# TrueCost environment template. Copy to .env and fill in only what you need.
#
#   cp .env.example .env
#
# Nothing here is required. The baseline runs with every value unset, which is the
# configuration `make smoke` and `make clean-run` are run under. Each unset provider
# falls back to a documented path. The response provenance block marks each fallback, rentalSource
# and hotelSource read SYNTHETIC and fuelPriceIsFallback is true. Fuel on its fallback and a
# synthetic hotel both report UNAVAILABLE in the freshness block.
#
# Spring reads these as environment variables, and nothing loads this file for you. Export it into
# the shell that runs the API before `make run` or `make prefetch`:
#
#   set -a && . ./.env && set +a
#
# .env is ignored by git, so a key written there is never committed. The defaults live in
# src/main/resources/application.yml.

# ---------------------------------------------------------------------------
# External providers. Both are disabled by default in application.yml.
# Setting a key here is not enough on its own, flip the matching enabled flag too, for example
#   TRUECOST_PROVIDERS_FUEL_EIA_ENABLED=true
# ---------------------------------------------------------------------------

# Regional fuel price, US Energy Information Administration.
# Unset, the fuel path uses truecost.providers.fuel.fallback-price-per-gallon, currently 3.50,
# and reports freshness UNAVAILABLE.
EIA_API_KEY=

# Lodging price, Amadeus test environment.
# Unset, the hotel path uses its synthetic estimate.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Infrastructure endpoints. The defaults match deploy/compose.yaml, so leave these
# alone for local development. Kubernetes overrides them in deploy/k8s/base/config.yaml.
# ---------------------------------------------------------------------------

# Apicurio schema registry. A map key containing dots does not bind cleanly from an underscored
# environment variable, so this is bound through a plain placeholder instead.
APICURIO_REGISTRY_URL=http://localhost:8081/apis/registry/v3

# OpenTelemetry trace export, Tempo.
TRUECOST_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ---------------------------------------------------------------------------
# Behaviour toggles
# ---------------------------------------------------------------------------

# Kafka event publishing from the API. Default false, which is why a default local run creates
# no topics. The prefetcher deployable sets this true for itself.
# TRUECOST_EVENTS_ENABLED=false

# Kafka Streams state directory for the prefetcher. Kept inside the project so a clean restart can
# delete it and two prefetchers on one machine never share it, I-16.
# TRUECOST_STREAM_STATE_DIR=./var/kafka-streams

# Spring profile. dev points at the compose stack on localhost, seed runs the one shot
# reference data loader and exits.
# SPRING_PROFILES_ACTIVE=dev
