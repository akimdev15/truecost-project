{
  "uid": "truecost-kafka",
  "title": "TrueCost Kafka Pipeline",
  "tags": ["truecost"],
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Consumer records lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Records lag per consumer, the prefetch and snapshot sink groups. Depends on the Kafka client Micrometer binding on the prefetcher.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (kafka_consumer_client_id) (kafka_consumer_fetch_manager_records_lag)",
          "legendFormat": "{{kafka_consumer_client_id}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Records consumed per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kafka_consumer_client_id) (rate(kafka_consumer_fetch_manager_records_consumed_total[1m]))",
          "legendFormat": "{{kafka_consumer_client_id}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Producer records sent per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kafka_producer_client_id) (rate(kafka_producer_record_send_total[1m]))",
          "legendFormat": "{{kafka_producer_client_id}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Stream thread liveness",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_stream_thread_metrics_alive_stream_threads",
          "legendFormat": "alive threads"
        }
      ]
    }
  ]
}
